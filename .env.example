# Runtime environment (never commit real values)
NODE_ENV=development
PORT=5001

# Local development only. Production must use the managed PostgreSQL connection.

SQLITE_DATABASE_PATH=./data/samarthloan.db
DATABASE_URL=postgresql://postgres.oytviahjzjkbpjrvuqbs:lk0JUCsydY3yjLD2@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

ALLOWED_ORIGINS=http://localhost:5173

